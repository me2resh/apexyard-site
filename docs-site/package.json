{
  "name": "apexyard-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "build": "node scripts/sync-content.mjs && astro build && node scripts/postbuild.mjs",
    "check": "node scripts/check-output.mjs && node --test tests/*.test.mjs",
    "lint": "node scripts/lint-docs.mjs",
    "lint:strict": "node scripts/lint-docs.mjs --strict --scope-only",
    "preview": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/starlight": "0.42.10",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.4.8",
    "github-slugger": "2.0.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
