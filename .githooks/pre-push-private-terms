#!/usr/bin/env bash
# Block a push whose outgoing commit messages hold a private term (#102).
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
. "$here/private-terms-lib.sh"
[ -r "$pt_file" ] || exit 0
zero=0000000000000000000000000000000000000000
dir=$(mktemp -d); trap 'rm -rf "$dir"' EXIT
while read -r _ lsha _ rsha; do
  if [ -z "${lsha:-}" ] || [ "$lsha" = "$zero" ]; then
    continue
  fi
  if [ "$rsha" = "$zero" ]; then
    range=("$lsha" --not --remotes)
  else
    range=("$rsha..$lsha")
  fi
  if ! shas=$(git rev-list "${range[@]}" 2>/dev/null); then
    echo "private-terms: warning: cannot list outgoing commits for a ref; CI checks them." >&2
    continue
  fi
  for sha in $shas; do
    git log -1 --format=%B "$sha" > "$dir/commit-${sha:0:7}"
  done
done
pt_scan "$dir"
