# Links that lychee must skip. One regular expression per line.
#
# Clean URLs of the three product pages (#102). The CDN serves /build,
# /gate and /readiness from build.html, gate.html and readiness.html, so
# the offline file check cannot resolve them. The CI workflow excludes the
# older clean URLs the same way.
^file://.*/(build|gate|readiness)(#[a-z-]+)?$
^file://.*/pricing#(build|gate|readiness|assessments)$
# Pages of the /docs sub-build. build-docs.sh builds them from docs-site/
# at deploy time, so they are not files in the repository root.
^file://.*/docs/quickstart/install$
^file://.*/docs/readiness/report-template$
# Their canonical production URLs return 404 until the pages reach
# production. Remove this line after the switch-on deploy.
^https://apexyard\.ai/(build|gate|readiness)$

# The waitlist page (#122). The CDN serves /waitlist from waitlist.html, so
# the offline file check cannot resolve it. Its canonical production URL
# returns 404 until the page reaches production. Remove the second line
# after the switch-on deploy.
^file://.*/waitlist(\?[a-z0-9=&-]*)?$
^https://apexyard\.ai/waitlist$

# Clean URL of the creators page (#123). The CDN serves /creators from
# creators.html, so the offline file check cannot resolve it. The canonical
# production URL returns 404 until the page reaches production. Remove the
# second line after the switch-on deploy.
^file://.*/creators$
^https://apexyard\.ai/creators$

# UK data protection regulator, linked from the privacy page (#154). Its
# site returns 403 to automated clients, but 200 in a browser.
^https://ico\.org\.uk/?$
